# Copy to backend/.env (gitignored) and fill in the secret key.
# Without these two settings the backend still works and returns id: null (D5).

# Supabase project "hypotekarna-kalkulacka" (eu-central-1). Not a secret.
SUPABASE_URL=https://rncaqhekknjdivkpadkw.supabase.co

# Dashboard → Project Settings → API Keys → Secret keys. Starts with sb_secret_.
# Server-side only: never put it in frontend/, never commit it.
SUPABASE_SECRET_KEY=

# Allowed frontend origins (comma-separated). Default: http://localhost:5173
# MORTGAGE_CORS_ORIGINS=http://localhost:5173
