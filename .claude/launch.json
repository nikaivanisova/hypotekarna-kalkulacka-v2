{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-m", "uv", "run", "--project", "backend", "--env-file", "backend/.env",
                      "python", "-m", "uvicorn", "mortgage.api.app:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000,
      "url": "http://localhost:8000"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
